{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hpsa",
  "main": "./_worker.js",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/releases/*"
    ]
  }
}
